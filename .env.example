# Tang Nails — environment variables
# Copy to .env.local and fill in real values. Placeholders below are non-secret
# and only document each variable; the scaffold's placeholder page reads none of them.

# --- Supabase ---
# Project URL (Project Settings → API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anonymous public API key. Safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — full database access. Server-only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Square ---
# Square application ID for the integration.
SQUARE_APPLICATION_ID=your-square-application-id
# Square application secret. Server-only.
SQUARE_APPLICATION_SECRET=your-square-application-secret
# Square API environment: sandbox or production.
SQUARE_ENVIRONMENT=sandbox
# Signature key used to verify incoming Square webhook payloads.
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key

# --- App ---
# Secret used to sign the "acting as staff" cookie. Server-only; use a long random string.
ACTING_AS_COOKIE_SECRET=change-me-to-a-long-random-string
# Enables the "Continue with Google" button on /login.
# Set to `true` only when Google credentials are configured in the Supabase dashboard.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
# IANA timezone the salon operates in (drives business-day boundaries).
SALON_TZ=America/Los_Angeles
